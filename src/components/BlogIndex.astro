---
import Layout from '../layouts/Layout.astro';
import LangSwitch from './LangSwitch.astro';
import { t, formatDate, localizePath, postLang, postUrl, type Lang } from '../i18n/ui';
import { SITE_NAME, authorJsonLd, getPublishedPosts, listedPosts } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = listedPosts(lang, await getPublishedPosts());

const alternates = { en: '/', fr: '/fr/' };
const site = Astro.site!;
const jsonLd = {
  '@type': 'Blog',
  name: SITE_NAME,
  url: new URL(localizePath(lang, '/'), site).href,
  description: t(lang, 'index.description'),
  inLanguage: lang,
  author: authorJsonLd(site, lang),
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: new URL(postUrl(post), site).href,
    datePublished: post.data.date.toISOString(),
    inLanguage: postLang(post),
  })),
};
---

<Layout title="oss.pm" lang={lang} description={t(lang, 'index.description')} alternates={alternates} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="topnav">
      <a href={localizePath(lang, '/virgile-deville/')}>{t(lang, 'nav.about')}</a>
      <LangSwitch lang={lang} />
    </nav>

    <header class="page-header">
      <h1 class="oss-logo">OSS.PM</h1>
      <p class="tagline">{t(lang, 'index.tagline')}</p>
    </header>

    <div class="card-list">
      {
        posts.map((post) => (
          <a class="card" href={postUrl(post)} hreflang={postLang(post)}>
            <div class="card-title" lang={postLang(post)}>
              {post.data.title}
              {postLang(post) !== lang && <span class="lang-tag">{postLang(post).toUpperCase()}</span>}
            </div>
            <p class="card-desc" lang={postLang(post)}>{post.data.description}</p>
            <time class="card-date" datetime={post.data.date.toISOString()}>
              {formatDate(lang, post.data.date)}
            </time>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
