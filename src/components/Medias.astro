---
import { getCollection } from 'astro:content';

const press = (await getCollection('press')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!-- Medias Section -->
<section class="success" id="medias">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 text-center">
        <h2>Press Room</h2>
        <hr class="news-light" />
        <p class="section-subtitle archive-note-light">
          Archive — press coverage from 2016-2017, mostly about the early French civic-tech scene.
        </p>
      </div>
    </div>
    <div class="row container">
      {
        press.map((post) => (
          <div class="col-sm-9 col-sm-offset-2">
            <blockquote>
              <a href={post.data.link} target="_blank" rel="noopener">
                <h4>
                  <span style="color:#fff;">{post.data.title}</span>
                </h4>
              </a>
              <small>
                <span style="color:#fff">{post.data.alt}</span>
              </small>
            </blockquote>
          </div>
        ))
      }
    </div>
  </div>
</section>
