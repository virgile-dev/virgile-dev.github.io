---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<!-- Portfolio Grid Section -->
<section id="portfolio">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 text-center">
        <h2>Projects &amp; focus areas</h2>
        <hr class="wrench-primary" />
        <p class="section-subtitle">Current work in digital commons, open source, and public-interest technology.</p>
      </div>
    </div>
    <div class="row">
      {
        projects.map((post) => (
          <div class="col-sm-6 col-md-4 portfolio-item">
            <a href={`#portfolioModal-${post.data.modalId}`} class="portfolio-link" data-toggle="modal">
              <div class="portfolio-card">
                {post.data.img ? (
                  <div class="portfolio-card-media">
                    <img src={`/img/portfolio/${post.data.img}`} class="img-responsive" alt={post.data.alt} />
                  </div>
                ) : (
                  <div class="portfolio-card-icon">
                    <i class={`fa ${post.data.icon ?? 'fa-code'}`} aria-hidden="true" />
                  </div>
                )}
                <h4>{post.data.title}</h4>
                <p class="portfolio-card-meta">{post.data.projectDate}</p>
                <span class="portfolio-card-more">
                  Learn more <i class="fa fa-arrow-right" />
                </span>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
