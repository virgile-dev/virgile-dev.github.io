---
import { site } from '../site.config';

const year = new Date().getFullYear();
---

<!-- Footer -->
<footer class="text-center">
  <div class="footer-above">
    <div class="container">
      <div class="row">
        <div class="footer-col col-md-4">
          <h3>{site.footer.location}</h3>
          <p>
            {
              site.address.map((line) => (
                <>
                  {line} <br />
                </>
              ))
            }
          </p>
        </div>
        <div class="footer-col col-md-4">
          <h3>{site.footer.social}</h3>
          <ul class="list-inline">
            {
              site.social.map((network) => (
                <li>
                  <a href={network.url} class="btn-social btn-outline">
                    <i class={`fa fa-fw fa-${network.title}`} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="footer-col col-md-4">
          <h3>{site.footer.credits}</h3>
          <p set:html={site.credits} />
        </div>
      </div>
    </div>
  </div>
  <div class="footer-below">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">Copyright &copy; {site.footer.copyright} {year}</div>
      </div>
    </div>
  </div>
</footer>

<!-- Scroll to Top Button (Only visible on small and extra-small screen sizes) -->
<div class="scroll-top page-scroll visible-xs visible-sm">
  <a class="btn btn-primary" href="#page-top">
    <i class="fa fa-chevron-up"></i>
  </a>
</div>
