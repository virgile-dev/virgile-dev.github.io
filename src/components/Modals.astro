---
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const rendered = await Promise.all(
  projects.map(async (post) => ({ post, Content: (await render(post)).Content })),
);
---

<!-- Portfolio Modals -->
{
  rendered.map(({ post, Content }) => (
    <div class="portfolio-modal modal fade" id={`portfolioModal-${post.data.modalId}`} tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-content">
        <div class="close-modal" data-dismiss="modal">
          <div class="lr">
            <div class="rl" />
          </div>
        </div>
        <div class="container">
          <div class="row">
            <div class="col-lg-8 col-lg-offset-2">
              <div class="modal-body">
                <h2>{post.data.title}</h2>
                <hr class="star-primary" />
                <ul class="list-inline item-details">
                  {post.data.website && (
                    <li>
                      <i class="fa fa-desktop" aria-hidden="true" />
                      <strong>
                        <a href={post.data.link ?? post.data.website} target="_blank" rel="noopener">
                          {post.data.website}
                        </a>
                      </strong>
                    </li>
                  )}
                  <li>
                    <i class="fa fa-clock-o" aria-hidden="true" />
                    <strong>{post.data.projectDate}</strong>
                  </li>
                  <li>
                    <i class="fa fa-map-marker" aria-hidden="true" />
                    <strong>{post.data.location}</strong>
                  </li>
                </ul>
                {post.data.img ? (
                  <img src={`/img/portfolio/${post.data.img}`} width="50%" class="img-responsive img-centered" alt={post.data.alt} />
                ) : (
                  <i class={`fa ${post.data.icon ?? 'fa-code'} fa-5x modal-icon`} aria-hidden="true" />
                )}
                <Content />
                <button type="button" class="btn btn-default" data-dismiss="modal">
                  <i class="fa fa-times" /> Close
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  ))
}
