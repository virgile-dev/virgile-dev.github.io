---
import { site } from '../site.config';
---

<!-- Header -->
<header>
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <img class="img-responsive img-rounded profile-photo" src="/img/profile.png" alt="Virgile Deville" />
        <div class="intro-text">
          <span class="name">{site.title}</span>
          <hr class="yo-light" />
          <h2>{site.description}</h2>
          <p>{site.skills}</p>
          <ul class="list-inline header-social">
            <li>
              <a href="https://github.com/virgile-dev" class="btn-outline" target="_blank" rel="noopener"
                ><i class="fa fa-fw fa-github" aria-hidden="true"></i> GitHub</a
              >
            </li>
            <li>
              <a
                href="https://www.linkedin.com/in/virgiledeville"
                class="btn-outline"
                target="_blank"
                rel="noopener"><i class="fa fa-fw fa-linkedin" aria-hidden="true"></i> LinkedIn</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>
