---
import Layout from '../layouts/Layout.astro';
import LangSwitch from './LangSwitch.astro';
import { render, type CollectionEntry } from 'astro:content';
import { t, formatDate, localizePath, otherLang, postLang, postUrl, type Lang } from '../i18n/ui';
import { SITE_NAME, OG_IMAGE, authorJsonLd } from '../site';

interface Props {
  post: CollectionEntry<'blog'>;
  translation?: CollectionEntry<'blog'>;
}

const { post, translation } = Astro.props;
const lang: Lang = postLang(post);
const { Content } = await render(post);

const alternates: Partial<Record<Lang, string>> = { [lang]: postUrl(post) };
if (translation) alternates[otherLang(lang)] = postUrl(translation);

const site = Astro.site!;
const url = new URL(postUrl(post), site).href;
const jsonLd = {
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  inLanguage: lang,
  url,
  mainEntityOfPage: url,
  image: new URL(OG_IMAGE, site).href,
  author: authorJsonLd(site, lang),
  publisher: { '@id': authorJsonLd(site, lang)['@id'] },
  isPartOf: { '@type': 'Blog', name: SITE_NAME, url: new URL(localizePath(lang, '/'), site).href },
};
---

<Layout
  title={`${post.data.title} — oss.pm`}
  description={post.data.description}
  lang={lang}
  alternates={alternates}
  type="article"
  published={post.data.date}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="topnav">
      <a href={localizePath(lang, '/')}>{t(lang, 'nav.blog')}</a>
      <LangSwitch lang={lang} targets={alternates} />
    </nav>

    <header class="page-header">
      <h1>{post.data.title}</h1>
      <time class="card-date" datetime={post.data.date.toISOString()}>
        {formatDate(lang, post.data.date)}
      </time>
      {
        translation && (
          <a class="translation-link" href={postUrl(translation)} hreflang={otherLang(lang)}>
            {t(lang, 'post.readIn')}
          </a>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </div>
</Layout>
