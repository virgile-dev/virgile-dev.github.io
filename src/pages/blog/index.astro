---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFormat = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title="Blog — Virgile Deville" description="Writing on open source product management and digital commons.">
  <div class="wrap">
    <nav class="topnav">
      <a href="/">← Virgile Deville</a>
    </nav>

    <header class="page-header">
      <h1>Blog</h1>
    </header>

    <div class="card-list">
      {
        posts.map((post) => (
          <a class="card" href={`/blog/${post.id}/`}>
            <div class="card-title">{post.data.title}</div>
            <p class="card-desc">{post.data.description}</p>
            <time class="card-date" datetime={post.data.date.toISOString()}>
              {dateFormat.format(post.data.date)}
            </time>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
