---
import '../styles/global.css';
import { t, defaultLang, localizePath, type Lang } from '../i18n/ui';
import { SITE_NAME, OG_IMAGE } from '../site';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** URL of this page in each language it exists in, for hreflang tags. */
  alternates?: Partial<Record<Lang, string>>;
  /** Open Graph type. */
  type?: 'website' | 'article' | 'profile';
  /** Article publication date, for og/article tags. */
  published?: Date;
  /** schema.org structured data, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const {
  title = 'Virgile Deville',
  lang = defaultLang,
  alternates = {},
  type = 'website',
  published,
  jsonLd,
} = Astro.props;
const description = Astro.props.description ?? t(lang, 'layout.description');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateLinks = Object.entries(alternates).map(([hreflang, href]) => ({
  hreflang,
  href: new URL(href, Astro.site),
}));
const xDefault = alternates[defaultLang];
const ogLocale = { en: 'en_US', fr: 'fr_FR' } as const;
const otherLocales = Object.keys(alternates).filter((l) => l !== lang) as Lang[];
const ogImage = new URL(OG_IMAGE, Astro.site);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Virgile Deville" />
    <link rel="canonical" href={canonicalURL} />
    {alternateLinks.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site)} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} (${lang.toUpperCase()})`}
      href={new URL(localizePath(lang, '/rss.xml'), Astro.site)}
    />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ubuntu-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#000000" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OSS.PM — Virgile Deville" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...jsonLd })} />}
  </head>
  <body>
    <slot />
  </body>
</html>
