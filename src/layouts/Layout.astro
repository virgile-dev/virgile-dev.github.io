---
import '../styles/global.css';
import { t, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** URL of this page in each language it exists in, for hreflang tags. */
  alternates?: Partial<Record<Lang, string>>;
}

const { title = 'Virgile Deville', lang = defaultLang, alternates = {} } = Astro.props;
const description = Astro.props.description ?? t(lang, 'layout.description');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateLinks = Object.entries(alternates).map(([hreflang, href]) => ({
  hreflang,
  href: new URL(href, Astro.site),
}));
const xDefault = alternates[defaultLang];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternateLinks.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <slot />
  </body>
</html>
